{
  "manifest_version": 3,
  "name": "Смены — прибыль",
  "version": "1.0.0",
  "description": "Следит за суммой прибыли на рабочем сайте и сам отправляет каждое изменение в приложение «Смены».",
  "permissions": ["storage", "scripting", "alarms", "activeTab"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Смены — прибыль",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
