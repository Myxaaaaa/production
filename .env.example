# Только для локального запуска: скопируйте в .env (необязательно).
# НЕ вставляйте этот файл в Railway целиком — там DATA_DIR=/data и свой пароль админа (см. README.md).

# Каталог для базы данных и резервных копий (локально).
DATA_DIR=./data

# Первый администратор создаётся при запуске, если такого логина ещё нет.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Администратор
# ADMIN_RESET_PASSWORD=1   # сбросить пароль этого админа на ADMIN_PASSWORD при следующем запуске

# Секрет подписи сессий (≥ 32 символов). Если не задан — генерируется и хранится в DATA_DIR.
# SESSION_SECRET=

# Часовой пояс графика: по нему определяется «сегодня» и время смен.
# APP_TIMEZONE=Asia/Bishkek

# PORT=3000
# SESSION_DAYS=30
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
