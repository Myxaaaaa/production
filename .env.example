# Скопируйте в .env для локального запуска (необязательно).

# Каталог для базы данных и резервных копий. На Railway — путь монтирования Volume, например /data.
DATA_DIR=./data

# Первый администратор создаётся при запуске, если такого логина ещё нет.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Администратор
# ADMIN_RESET_PASSWORD=1   # сбросить пароль этого админа на ADMIN_PASSWORD при следующем запуске

# Секрет подписи сессий (≥ 32 символов). Если не задан — генерируется и хранится в DATA_DIR.
# SESSION_SECRET=

# PORT=3000
# SESSION_DAYS=30
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
